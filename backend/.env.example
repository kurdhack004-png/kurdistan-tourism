APP_NAME="Kurdistan Tourism API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# PostgreSQL (Render production values must be entered as secrets)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kurdistan_tourism
DB_USERNAME=postgres
DB_PASSWORD=

# Runtime services
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis

SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# Object storage (S3-compatible)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=kurdistan-tourism-media
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment provider configuration (never commit real credentials)
FIB_API_BASE=
FIB_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Production hardening
LOG_CHANNEL=stderr
LOG_LEVEL=info
SESSION_SECURE_COOKIE=true

# Never commit the real .env file — this is a template only.
