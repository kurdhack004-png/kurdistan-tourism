    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "clickbar/laravel-magellan": "^2.0",
        "spatie/laravel-query-builder": "^6.0",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
